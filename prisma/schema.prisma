generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NextAuth models ---
// Google sign-in is only the ban anchor / API-key-issuing gate. Per-message
// identity comes from the API key + chatId, never the login session.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  apiKeys      ApiKey[]
  telegram     TelegramLink?
  messages     Message[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- MCP API keys ---
// Raw key format: `tg_live_<48 hex>`. SHA-256 hash stored; raw shown once.

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  keyHash    String    @unique
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Telegram link ---
// One row per user who's connected a bot. webhookSecret is a per-user
// random URL segment. chatId is filled the first time the user DMs /start.
// lastPulledAt is the cursor for get_new_messages — messages with role=user
// created after this timestamp are "unread". windowSize governs how many
// messages /recent and list_recent_messages surface by default.

model TelegramLink {
  id            String   @id @default(cuid())
  userId        String   @unique
  botToken      String
  botUsername   String?
  webhookSecret String   @unique
  chatId        String?
  lastPulledAt  DateTime @default(now())
  windowSize    Int      @default(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

// --- Conversation history ---
// Every message in and out is logged. "role" follows OpenAI convention:
//   "user"      — inbound from the human on Telegram
//   "assistant" — outbound to Telegram (either from the agent via
//                 send_telegram_message, or from the platform itself
//                 replying to a slash-command).

model Message {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
