# --- Required ---
DATABASE_URL="postgresql://admin:admin@db:5432/telegram_mcp"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="http://localhost:3012"

# Public base URL that OAuth callbacks + Telegram webhooks point at.
# In prod set to your https:// domain (e.g. https://telegram.regiq.in).
PUBLIC_BASE_URL="http://localhost:3012"

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Scopes on the consent screen: openid, email, profile.
# Redirect URI: <PUBLIC_BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- No LLM required ---
# This bridge does not do inference. Your agent (Claude Desktop, Cursor,
# custom script) supplies its own model. Nothing to configure here.
