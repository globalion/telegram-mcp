# --- Required ---
DATABASE_URL="postgresql://admin:admin@db:5432/telegram_mcp"

NEXTAUTH_SECRET="CHANGE_ME"                       # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3012"
PUBLIC_BASE_URL="http://localhost:3012"           # https://... in prod

# --- Sign-in providers (add any subset; unset providers are hidden) ---

# Google — https://console.cloud.google.com/apis/credentials
# Redirect: <PUBLIC_BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub — https://github.com/settings/applications/new
# Callback: <PUBLIC_BASE_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Facebook — https://developers.facebook.com/apps → Add Facebook Login product
# Valid OAuth Redirect URI: <PUBLIC_BASE_URL>/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Microsoft (Outlook / Live / work-school) — https://entra.microsoft.com → App registrations
# Redirect: <PUBLIC_BASE_URL>/api/auth/callback/microsoft-entra-id
# Issuer 'common' supports personal + work accounts; keep default unless single-tenant.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# --- No LLM required ---
# This bridge does not do inference. Your agent supplies its own model.
